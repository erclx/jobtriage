{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "echo 'bun run dev is disabled. Run bun run restart:web from the repo root.' && exit 1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
