{
  "components": {
    "schemas": {
      "AdSummary": {
        "additionalProperties": false,
        "properties": {
          "ad_id": {
            "title": "Ad Id",
            "type": "string"
          },
          "application_deadline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Application Deadline"
          },
          "employer_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Employer Name"
          },
          "headline": {
            "title": "Headline",
            "type": "string"
          },
          "municipality": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Municipality"
          },
          "webpage_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webpage Url"
          }
        },
        "required": ["ad_id", "headline"],
        "title": "AdSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "db_path": {
            "title": "Db Path",
            "type": "string"
          },
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status", "db_path", "model_name"],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobSearchRequest": {
        "additionalProperties": false,
        "properties": {
          "occupation_concept_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "JobTech occupation concept id to filter by.",
            "title": "Occupation Concept Id"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "JobTech region concept id to filter by.",
            "title": "Region"
          },
          "top_k": {
            "default": 10,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "title": "JobSearchRequest",
        "type": "object"
      },
      "JobSearchResponse": {
        "additionalProperties": false,
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/AdSummary"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": ["results"],
        "title": "JobSearchResponse",
        "type": "object"
      },
      "RankedAd": {
        "additionalProperties": false,
        "properties": {
          "ad_id": {
            "title": "Ad Id",
            "type": "string"
          },
          "application_deadline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Application Deadline"
          },
          "employer_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Employer Name"
          },
          "headline": {
            "title": "Headline",
            "type": "string"
          },
          "municipality": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Municipality"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "webpage_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webpage Url"
          }
        },
        "required": ["ad_id", "headline", "score"],
        "title": "RankedAd",
        "type": "object"
      },
      "SemanticSearchRequest": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "top_k": {
            "default": 10,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": ["query"],
        "title": "SemanticSearchRequest",
        "type": "object"
      },
      "SemanticSearchResponse": {
        "additionalProperties": false,
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/RankedAd"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": ["results"],
        "title": "SemanticSearchResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "HTTP layer over the jobtriage Python tools.",
    "title": "jobtriage",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": ["health"]
      }
    },
    "/v1/jobs/search": {
      "post": {
        "operationId": "search_jobs_v1_jobs_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Jobs",
        "tags": ["jobs"]
      }
    },
    "/v1/jobs/semantic": {
      "post": {
        "operationId": "semantic_search_v1_jobs_semantic_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SemanticSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SemanticSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Semantic Search",
        "tags": ["jobs"]
      }
    }
  }
}
